{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },

  "AllowedHosts": "*",

  "Environment": "Production",

  "Kubernetes": {
    "Namespace": "ecp-prod",
    "ServiceDnsSuffix": "svc.cluster.local"
  },

  "Gateway": {
    "EnableRateLimiting": true,
    "DefaultRateLimitPermitLimit": 100,
    "DefaultRateLimitWindowSeconds": 10,

    "EnableResponseCompression": true,
    "EnableRequestLogging": true,

    "TimeoutSeconds": 30,
    "CircuitBreakerEnabled": true
  },

  "DownstreamServices": {
    "Warehouse": "http://ecp-warehouse.ecp-prod.svc.cluster.local",
    "Inventory": "http://ecp-inventory.ecp-prod.svc.cluster.local",
    "Order": "http://ecp-order.ecp-prod.svc.cluster.local"
  },

  "Cloudflare": {
    "PublicBaseUrl": "https://ecpws-uat.notcode.uk"
  }
}