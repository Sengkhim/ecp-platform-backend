{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kubernetes": {
    "Namespace": "ecp-dev",        
    "IngressBaseUrl": "http://ecp-warehouse.ecp-dev.svc.cluster.local"
  },
  "Gateway": {
    "EnableRateLimiting": true,
    "DefaultRateLimitPermitLimit": 100,
    "DefaultRateLimitWindowSeconds": 10
  }
}
