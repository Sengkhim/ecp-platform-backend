{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug",
      "ECP.ApiGateway": "Debug"
    }
  },

  "Kubernetes": {
    "Namespace": "ecp-dev"
  },

  "Gateway": {
    "EnableRateLimiting": false,
    "DefaultRateLimitPermitLimit": 1000,
    "DefaultRateLimitWindowSeconds": 10,
    "TimeoutSeconds": 60,
    "CircuitBreakerEnabled": false
  },

  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317",
    "Protocol": "Grpc"
  }
}