{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Information",
      "Confluent.Kafka": "Warning"
    }
  },

  "MongoDB": {
    "SagaConnection": "mongodb://root:pass168@mongodb.ecp-prod.svc.cluster.local:27017/sagas?authSource=admin&serverSelectionTimeoutMS=5000&connectTimeoutMS=5000"
