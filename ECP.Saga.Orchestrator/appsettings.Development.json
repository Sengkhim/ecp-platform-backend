    "PaymentUrl":      "http://ecp-payment.ecp-prod.svc.cluster.local",
    "WarehouseUrl":    "http://ecp-warehouse.ecp-prod.svc.cluster.local",
    "NotificationUrl": "http://ecp-notification.ecp-prod.svc.cluster.local"
  },

  "AllowedHosts": "*"
